<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 蓝牙手表（HryFine）：Android 12+ 用 SCAN/CONNECT，旧版本用传统蓝牙 + 定位权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台应用获取：UsageStatsManager，需用户在设置中手动授予（特殊权限，非运行时权限） -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+：常驻上报属于用户主动开启的持续监控，使用 specialUse 类型，
         避免 dataSync 类型在 Android 15 的每日约 6 小时配额导致后台断开 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 可选：通过 Shizuku（adb/root 授权）代为授予权限并执行后台保活命令 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 仅用于引导用户跳转电池优化白名单设置页，申请豁免 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内自更新安装 APK 时需要（Android 8+） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 11+ 包可见性：需解析任意已安装应用（前台/可见应用）的名称。
         持有 PACKAGE_USAGE_STATS 时系统会自动授予全部可见性，但部分 ROM 的
         自动可见性实现不稳定，这里显式声明兜底。应用为自行分发，无商店政策限制。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name=".MugshotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mugshot"
        android:usesCleartextTraffic="true">

        <!-- 首启隐私政策 + 主界面 -->
        <activity
            android:name=".PrivacyActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <!-- 设备状态上报前台服务：specialUse 类型（无每日时长配额，避免 dataSync 在
             Android 15 的 6 小时限制；仍保留 WorkManager 周期 HTTP 兜底）。
             stopWithTask=false：从最近任务划掉后服务继续运行，配合 onTaskRemoved 保活 -->
        <service
            android:name=".ReportService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的个人设备状态远程上报（持续连接自建服务器）" />
        </service>

        <!-- 看门狗：每 15 分钟检查上报服务是否存活，被系统杀掉时重新拉起 -->
        <receiver
            android:name=".WatchdogReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Shizuku 授权回调（由其 App 通过该 Provider 回传授权状态） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 覆盖安装/应用更新后重新拉起上报服务，避免更新后掉线 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
