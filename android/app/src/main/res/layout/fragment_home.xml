<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 连接状态卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <View
                android:id="@+id/state_dot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/dot_red" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/state_offline"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main" />

                <TextView
                    android:id="@+id/status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/state_detail_empty"
                    android:textSize="13sp"
                    android:textColor="@color/text_sub" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_probe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_retest"
            android:textColor="@color/white" />

        <!-- 设备信息卡 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/home_section_device"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <include layout="@layout/view_info_row" android:id="@+id/row_battery" />
            <include layout="@layout/view_info_row" android:id="@+id/row_temperature" />
            <include layout="@layout/view_info_row" android:id="@+id/row_network" />
            <include layout="@layout/view_info_row" android:id="@+id/row_screen" />
            <include layout="@layout/view_info_row" android:id="@+id/row_foreground" />
            <include layout="@layout/view_info_row" android:id="@+id/row_device_model" />
            <include layout="@layout/view_info_row" android:id="@+id/row_android_ver" />
            <include layout="@layout/view_info_row" android:id="@+id/row_device_name" />
            <include layout="@layout/view_info_row" android:id="@+id/row_device_id" />
            <include layout="@layout/view_info_row" android:id="@+id/row_report_interval" />
            <include layout="@layout/view_info_row" android:id="@+id/row_last_report" />
            <include layout="@layout/view_info_row" android:id="@+id/row_server" />
        </LinearLayout>

        <!-- 蓝牙手表卡 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/home_section_watch"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/watch_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/watch_title_off"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/watch_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/watch_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/watch_status_off"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/watch_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/view_info_row" android:id="@+id/row_watch_battery" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_steps" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_heart" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_sleep" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_spo2" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_bp" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_firmware" />
                <include layout="@layout/view_info_row" android:id="@+id/row_watch_sync" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_measure_heart"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_measure_heart"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_measure_bp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/btn_measure_bp"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_measure_spo2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/btn_measure_spo2"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_watch_connect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_watch_connect"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <Button
                    android:id="@+id/btn_watch_sync"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/btn_watch_sync"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_watch_unbind"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/btn_watch_unbind"
                android:textColor="@color/red"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 血糖卡：手表不提供血糖，由用户手动录入，随上报一起发送 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/home_section_glucose"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/glucose_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/glucose_none"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/glucose_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_glucose_record"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_glucose_record" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/perm_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/perm_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/warn"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/perm_vendor_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_usage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_usage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_battery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_autostart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Shizuku 增强卡（可选）：自动授权使用情况权限 + 后台保活 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/home_section_shizuku"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/shizuku_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shizuku_not_running"
                android:textColor="@color/text_sub"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/shizuku_hint"
                android:textColor="@color/text_sub"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_shizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_shizuku_grant"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
