#!/usr/bin/env bash
# mugshot-server 管理菜单（由应用菜单"Mugshot 服务端"启动，也可手动运行）
# 无需 root 即可打开；查看配置/重启服务等操作会按需请求 sudo
SVC="mugshot-server"
CFG="/etc/mugshot/config.json"

pause() {
    echo
    read -rp "按回车返回菜单..." _
}

show_status() {
    echo "================ 服务状态 ================"
    systemctl status "$SVC" --no-pager -l 2>&1 || true
    echo
    echo "================ 监听端口 ================"
    ss -tln 2>/dev/null | grep -E ':8080|mugshot' || echo "(服务未运行或未监听)"
    echo
    echo "本机访问验证: curl http://127.0.0.1:8080/health"
    echo "局域网服务器地址: http://本机IP:8080 （IP 可用 ip addr 查看）"
    pause
}

show_token() {
    echo "================ 配置内容 ================"
    echo "（device_token 填手机 App；plugin_token 填 Yunzai 插件）"
    echo
    if [ -r "$CFG" ]; then
        cat "$CFG"
    else
        echo "(配置需要管理员权限读取，可能提示输入密码)"
        sudo -p "[sudo] 密码: " cat "$CFG" 2>/dev/null || echo "(读取失败，可手动执行: sudo cat $CFG)"
    fi
    echo
    echo "局域网 IP："
    hostname -I 2>/dev/null || ip -4 addr show scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+)+'
    pause
}

show_logs() {
    echo "实时日志（按 Ctrl+C 返回菜单）..."
    journalctl -u "$SVC" -f --no-pager
}

do_restart() {
    echo "(可能提示输入密码)"
    sudo systemctl restart "$SVC" && echo "已重启" || echo "重启失败"
    systemctl is-active "$SVC"
    pause
}

do_stop_start() {
    if systemctl is-active --quiet "$SVC"; then
        echo "(可能提示输入密码)"
        sudo systemctl stop "$SVC" && echo "已停止"
    else
        echo "(可能提示输入密码)"
        sudo systemctl start "$SVC" && echo "已启动"
    fi
    systemctl is-active "$SVC"
    pause
}

edit_config() {
    echo "(可能提示输入密码)"
    editor="${VISUAL:-${EDITOR:-nano}}"
    sudo "$editor" "$CFG" 2>/dev/null || sudo vi "$CFG"
    echo "修改配置后需重启服务生效（菜单选 4）"
    pause
}

while true; do
    clear
    echo "=========================================="
    echo "       Mugshot 服务端管理 ($SVC)"
    echo "=========================================="
    echo "  当前状态: $(systemctl is-active "$SVC" 2>/dev/null || echo unknown)"
    echo
    echo "  1) 查看服务状态与验证方法"
    echo "  2) 查看配置（token / 服务器地址）"
    echo "  3) 查看实时日志"
    echo "  4) 重启服务"
    echo "  5) 启动 / 停止服务"
    echo "  6) 编辑配置"
    echo "  0) 退出"
    echo
    read -rp "请选择: " choice
    case "$choice" in
        1) show_status ;;
        2) show_token ;;
        3) show_logs ;;
        4) do_restart ;;
        5) do_stop_start ;;
        6) edit_config ;;
        0) exit 0 ;;
        *) ;;
    esac
done
