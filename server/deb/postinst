#!/bin/sh
# mugshot-server deb 包 postinst：建用户、生成配置、启动服务
set -e

SERVICE_USER="mugshot"

# 1) 系统用户（幂等）
if ! id "$SERVICE_USER" >/dev/null 2>&1; then
  if command -v adduser >/dev/null 2>&1; then
    adduser --system --group --no-create-home --home /nonexistent \
      --shell /usr/sbin/nologin "$SERVICE_USER"
  else
    useradd --system --no-create-home --shell /usr/sbin/nologin "$SERVICE_USER"
    groupadd -f "$SERVICE_USER"
    usermod -g "$SERVICE_USER" "$SERVICE_USER"
  fi
fi

# 2) 配置文件（升级时保留既有配置与 token；首次安装生成模板，
#    空 token 由服务端首次启动时自动生成随机值并写回）
mkdir -p /etc/mugshot
if [ ! -f /etc/mugshot/config.json ]; then
  cat > /etc/mugshot/config.json <<'EOF'
{
  "listen": ":8080",
  "data_dir": "/var/lib/mugshot/data",
  "token": "",
  "report_rate_per_min": 30,
  "fresh_timeout_ms": 5000,
  "fresh_cooldown_ms": 5000,
  "retention_days": 7,
  "online_timeout_sec": 120,
  "github_repo": "huliaiya/Mugshot",
  "update_auto_check": true
}
EOF
  chmod 600 /etc/mugshot/config.json
fi
# 配置目录归属服务用户：GUI 修改设置时需要在该目录写入临时文件再原子替换
chown "$SERVICE_USER:$SERVICE_USER" /etc/mugshot
chown "$SERVICE_USER:$SERVICE_USER" /etc/mugshot/config.json
chmod 750 /etc/mugshot
chmod 600 /etc/mugshot/config.json

# 3) 数据目录（StateDirectory 已建 /var/lib/mugshot，这里补 data 子目录）
mkdir -p /var/lib/mugshot/data
chown -R "$SERVICE_USER:$SERVICE_USER" /var/lib/mugshot

# 4) 启用并启动服务
if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  systemctl enable mugshot-server.service || true
  systemctl restart mugshot-server.service || true
fi

# 5) v1.0.14 起菜单只保留"Mugshot 服务端"图形入口，清理旧版本遗留的终端菜单图标
rm -f /usr/share/applications/mugshot-server.desktop

# 6) 刷新桌面应用菜单缓存
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
fi

if [ "$1" = "configure" ]; then
  echo ""
  echo "=============================================="
  echo " mugshot-server 安装完成，服务已启动"
  echo " 它是后台服务，无窗口图标属正常现象"
  echo "----------------------------------------------"
  echo " 应用菜单点\"Mugshot 服务端\"打开管理面板"
  echo " 无桌面或 SSH 场景: 在终端运行 mugshot-ctl"
  echo " 验证运行:            curl http://127.0.0.1:8080/health"
  echo " 查看自动生成的 token: sudo cat /etc/mugshot/config.json"
  echo " 服务状态:            systemctl status mugshot-server"
  echo " 实时日志:            journalctl -u mugshot-server -f"
  echo " 数据目录:            /var/lib/mugshot"
  echo "=============================================="
fi

exit 0
